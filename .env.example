# Shape only. Real values are rendered from SOPS by the homelab deploy into
# /srv/chat/.env, which is both this compose project's env_file and the file
# Compose interpolates CHAT_IMAGE_TAG from.

# Image tag the deploy pins, as sha-<short>. Never a floating tag.
CHAT_IMAGE_TAG=

# Listener. Port 3001 is mapped to host 80 by docker-compose.yml.
SERVER_PORT=3001
HOST=0.0.0.0

# Root the agent may open projects under. Anything outside is refused.
WORKSPACES_ROOT=/srv/corpus

# Under HOME=/data, so the database survives an image replacement.
DATABASE_PATH=/data/auth.db

# Signs the sessions nobody logs into. Still set, because an unset value makes
# CloudCLI generate a new one per start.
JWT_SECRET=

# Disables CloudCLI's own login, server side and client side. The image already
# sets this to match what its client bundle was compiled with. Overriding it
# here to anything but true breaks the two apart.
VITE_IS_PLATFORM=true

# Authenticates the claude binary the agent runs as.
CLAUDE_CODE_OAUTH_TOKEN=

# Token budget the usage meter measures against. Blank falls back to 160000.
CONTEXT_WINDOW=
